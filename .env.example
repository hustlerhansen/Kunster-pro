# =====================================================================
# Kunstner Pro – miljøvariabler (kopier til .env.local og fyll inn)
# Se docs/MILJOVARIABLER.md for forklaring. Aldri commit ekte nøkler.
# Uten Supabase-variablene kjører butikken i DEMOMODUS (kun katalog og handlekurv).
# =====================================================================

# --- Nettsted ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (database + innlogging) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Kun server. Gir full databasetilgang – må aldri eksponeres i klienten.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (kortbetaling via Stripe Checkout) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Vipps MobilePay ePayment (forberedt, av som standard) ---
VIPPS_ENABLED=false
VIPPS_ENV=test
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_MSN=
VIPPS_WEBHOOK_SECRET=

# --- Fakturakjøp for bedrifter (handlekonto) ---
# Holdes AV til juridiske, økonomiske og tekniske krav er avklart.
FEATURE_BUSINESS_INVOICE=false

# --- E-post (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="Kunstner Pro <ordre@dittdomene.no>"
EMAIL_REPLY_TO=
ADMIN_NOTIFICATION_EMAIL=

# --- Frakt (forberedt for transportørintegrasjon) ---
BRING_API_UID=
BRING_API_KEY=
BRING_CUSTOMER_NUMBER=
POSTNORD_API_KEY=

# --- Enhetsregisteret (åpent API, ingen nøkkel). Kun for å overstyre i test.
# BRREG_API_URL=https://data.brreg.no/enhetsregisteret/api

# --- Analyse (lastes kun etter samtykke) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Planlagte jobber (Vercel Cron) ---
CRON_SECRET=
